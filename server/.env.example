# Server
PORT=4000
NODE_ENV=development
OPENCLAW_WORKSPACE=E:/projek-ai/openclaw/workspace

# 9Router / local Hermes OpenAI-compatible gateway (preferred when configured).
# Copy HERMES_CUSTOM_LOCALHOST_20128_API_KEY from %LOCALAPPDATA%\hermes\.env.
# GET http://localhost:20128/v1/models lists valid model IDs.
# Values containing YOUR_ are intentionally ignored by server loader.
NINEROUTER_API_BASE=http://localhost:20128/v1
NINEROUTER_API_KEY=YOUR_HERMES_LOCAL_API_KEY
NINEROUTER_PRD_MODEL=cx/gpt-5.6-terra
NINEROUTER_TASK_MODEL=cx/gpt-5.4-mini
# Optional shared default model
NINEROUTER_MODEL=cx/gpt-5.6-terra
# Gateway request timeout in milliseconds (default 240000)
NINEROUTER_TIMEOUT_MS=240000

# AI provider fallbacks. Set one or more keys as needed.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Used only in generated NextAuth configuration.
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET
